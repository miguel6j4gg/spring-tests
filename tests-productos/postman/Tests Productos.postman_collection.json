            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"codigo\": \"PROD-001\",\n    \"nombre\": \"Filtro de aceite\",\n    \"descripcion\": \"Filtro de aceite para grupo electrogeno\",\n    \"categoria\": \"Repuestos\",\n    \"precio\": 45.50,\n    \"stock\": 100,\n    \"estado\": \"Activo\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/productos", "host": ["{{baseUrl}}"], "path": ["productos"] },
            "description": "POST 1 - Registrar producto. Si el codigo ya existe responde 409."
