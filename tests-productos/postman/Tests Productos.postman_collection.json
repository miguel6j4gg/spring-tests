      "name": "01 Producto",
      "item": [
        {
          "name": "Registrar producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('codigo coincide con el enviado', function () {",
                  "    pm.expect(body.codigo).to.eql('PROD-001');",
                  "});",
                  "pm.collectionVariables.set('productoId', body.id);"
